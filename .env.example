# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Override the SQLite database path (default: data/jobs.db)
# DB_PATH=data/jobs.db

# Minimum score threshold for displaying jobs (default: 1)
# MIN_SCORE=1

# RemoteOK API URL override (default: https://remoteok.com/api)
# REMOTEOK_API_URL=https://remoteok.com/api
